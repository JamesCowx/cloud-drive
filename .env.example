# PostgreSQL connection string (used by Prisma and the app)
DATABASE_URL="postgresql://user:password@localhost:5432/cloud"

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-me-with-a-long-random-string"

# Where uploaded files are stored on disk (absolute or relative to project root)
UPLOAD_DIR="./storage"
